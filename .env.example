# TeslaMate Postgres connection (read-only access is enough)
TESLAMATE_DB_URL=postgres://teslamate:password@192.168.x.x:5432/teslamate

# Microsoft Graph, mode 1 (default): device code flow.
# Azure app registration: public client, delegated permission Calendars.Read.
GRAPH_CLIENT_ID=
# Use your tenant id for a work/school account, or "consumers" for personal Microsoft accounts
GRAPH_TENANT_ID=common

# Microsoft Graph, mode 2 (optional, non-interactive): client credentials.
# Requires an app with the Calendars.Read APPLICATION permission (admin consent).
# Set these two (plus GRAPH_CLIENT_ID/GRAPH_TENANT_ID above) and no sign-in is needed:
#GRAPH_CLIENT_SECRET=
#GRAPH_USER_UPN=you@yourtenant.com
# Or point at an existing env file holding MSGRAPH_TENANT_ID / MSGRAPH_CLIENT_ID /
# MSGRAPH_CLIENT_SECRET / MSGRAPH_SENDER_UPN:
#GRAPH_ENV_FILE=

# Matching parameters
MATCH_RADIUS_M=500
ARRIVE_EARLY_MIN=120
ARRIVE_LATE_MIN=20
INCLUDE_RETURN=true

# Reporting
MILEAGE_RATE=0.70

# Contact email sent in the Nominatim geocoding User-Agent (their usage policy asks for one)
NOMINATIM_EMAIL=
