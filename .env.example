# TeslaMate Postgres connection (read-only access is enough)
TESLAMATE_DB_URL=postgres://teslamate:password@192.168.x.x:5432/teslamate

# Microsoft Graph, mode 1 (default): device code flow.
# Azure app registration: public client, delegated permission Calendars.Read.
GRAPH_CLIENT_ID=
# Use your tenant id for a work/school account, or "consumers" for personal Microsoft accounts
GRAPH_TENANT_ID=common

# Microsoft Graph, mode 2 (optional, non-interactive): client credentials.
# Requires an app with the Calendars.Read APPLICATION permission (admin consent).
# Set these two (plus GRAPH_CLIENT_ID/GRAPH_TENANT_ID above) and no sign-in is needed:
#GRAPH_CLIENT_SECRET=
#GRAPH_USER_UPN=you@yourtenant.com
# Or point at an existing env file holding MSGRAPH_TENANT_ID / MSGRAPH_CLIENT_ID /
# MSGRAPH_CLIENT_SECRET / MSGRAPH_SENDER_UPN:
#GRAPH_ENV_FILE=

# Matching parameters
MATCH_RADIUS_M=500
ARRIVE_EARLY_MIN=120
ARRIVE_LATE_MIN=20
INCLUDE_RETURN=true
# A later drive of this many miles or less leaving the meeting area is a
# repositioning hop (moving the car down the block), never the return leg
REPOSITION_MAX_MILES=1
# A departing drive of this many miles or less is a short errand (a pharmacy, a
# store) rather than the drive home, provided a longer drive follows it within
# ERRAND_MAX_GAP_MIN minutes; that longer drive becomes the return leg. Set to
# 0 to turn errand handling off.
ERRAND_MAX_MILES=3
ERRAND_MAX_GAP_MIN=60

# Venues the geocoder cannot resolve (bare venue names), pinned to coordinates
# by hand. Copy venues.example.json to venues.json and list your own. Without
# the file, the feature is simply off.
#VENUES_FILE=

# Personal events that carry a street address (a school pickup, a dentist)
# would otherwise match a drive and be logged as business. An event is skipped
# when Outlook marks it personal, when its subject contains PERSONAL_MARKER
# (default "(personal)"; set it empty to turn the marker off), or when its
# subject contains a term from personal.json. Copy personal.example.json to
# personal.json and list your own terms.
#PERSONAL_MARKER=(personal)
#PERSONAL_FILE=

# Transport hubs (stations, airports) where a trip continues by rail or air.
# Copy hubs.example.json to hubs.json and list your own. Without the file,
# hub matching is simply off.
#HUBS_FILE=
HUB_RADIUS_M=750
# How long before a meeting a drive to a hub may end (rail/air legs start early)
HUB_DEPART_EARLY_MIN=480
# How long after a meeting the drive home from the hub may start
HUB_RETURN_MAX_HOURS=12

# Reporting. Each trip is priced at the rate in force on its date. By default
# that is the IRS business rate, which changes every year and sometimes in the
# middle of one (2026: $0.725 through June 30, $0.76 from July 1).
# For your own dated rates, copy rates.example.json to rates.json and edit it.
#RATES_FILE=
# For ONE flat rate on every date (an employer's reimbursement rate), set
# MILEAGE_RATE. It overrides both tables, so leave it unset to follow the IRS.
# It must be confirmed before it may differ from the IRS rate for a day.
#MILEAGE_RATE=0.58
#MILEAGE_RATE_CONFIRMED=true

# Contact email sent in the Nominatim geocoding User-Agent (their usage policy asks for one)
NOMINATIM_EMAIL=
