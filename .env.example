# TeslaMate Postgres connection (read-only access is enough)
TESLAMATE_DB_URL=postgres://teslamate:password@192.168.x.x:5432/teslamate

# Microsoft Graph (Azure app registration, public client, device code flow)
# Delegated permission required: Calendars.Read
GRAPH_CLIENT_ID=
# Use your tenant id for a work/school account, or "consumers" for personal Microsoft accounts
GRAPH_TENANT_ID=common

# Matching parameters
MATCH_RADIUS_M=500
ARRIVE_EARLY_MIN=120
ARRIVE_LATE_MIN=20
INCLUDE_RETURN=true

# Reporting
MILEAGE_RATE=0.70

# Contact email sent in the Nominatim geocoding User-Agent (their usage policy asks for one)
NOMINATIM_EMAIL=
